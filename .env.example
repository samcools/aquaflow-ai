# AquaFlow AI environment template
# Copy to .env for local development. Never commit real secret values.

APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:8000
PORT=8000

# Demo authentication (hackathon only)
DEMO_MODE=true
DEMO_ADMIN_EMAIL=demo@aquaflow.local
DEMO_ADMIN_PASSWORD=ChangeMe!2026
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# AI: deterministic is the safe no-key fallback.
# A user may also enter an OpenAI key from Ayanda > AI & Voice Settings.
# In-app keys are held only in server memory for the authenticated session.
AI_PROVIDER=deterministic
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Browser speech remains the fallback when OpenAI neural speech is not configured.
TTS_PROVIDER=openai-when-configured
STT_PROVIDER=browser
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Integrations: leave blank until actually configured and tested.
GIS_PROVIDER=
BILLING_PROVIDER=
SCADA_PROVIDER=
TELEMETRY_PROVIDER=
NOTIFICATION_PROVIDER=

# Secure document storage
MAX_UPLOAD_MB=10
STORAGE_PROVIDER=local-private
STORAGE_BUCKET=

# Future production persistence
DATABASE_URL=

LOG_LEVEL=info
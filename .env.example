# AquaFlow AI environment template
# Copy to .env for local development. Never commit real secret values.

APP_ENV=development
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000

# Demo authentication only. Change before any shared deployment.
# Production startup is intentionally blocked when the default password is retained.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=demo@aquaflow.local
DEMO_ADMIN_PASSWORD=ChangeMe!2026
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# Future database / identity integrations
DATABASE_URL=
IDENTITY_PROVIDER=

# AI integration. The current hackathon assistant can run deterministically without an LLM.
OPENAI_API_KEY=
AI_MODEL=

# Voice / speech integrations. Browser speech is the current demo fallback.
TTS_PROVIDER=
STT_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

STORAGE_PROVIDER=
STORAGE_BUCKET=
GIS_PROVIDER=
NOTIFICATION_PROVIDER=
LOG_LEVEL=info
